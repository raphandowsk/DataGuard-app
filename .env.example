# Supabase — copy to .env.local and fill in from your Supabase project settings.
# Get these from: Supabase dashboard → Project Settings → API
# Both are PUBLIC (shipped to the browser). For the static export these are
# inlined at BUILD time, so they must be present when `npm run build` runs
# (see DEPLOYMENT.md). The current project's values:
#   NEXT_PUBLIC_SUPABASE_URL=https://udlrihnuwfwndbpmxqtq.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PJ5CtduzMgaIIUDW9VE0hg_nG3fTEc9
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for seeding/admin tasks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
