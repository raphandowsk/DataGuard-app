# Production build config for the static export.
# Both values are PUBLIC (the publishable key is meant to be shipped to the
# browser) and are inlined into the static bundle at `next build` time. Keeping
# them here means every build — local, GitHub Actions, or a Hostinger build —
# is correctly configured, instead of silently shipping "Supabase is not
# configured". To point at a different Supabase project, change these two lines.
NEXT_PUBLIC_SUPABASE_URL=https://udlrihnuwfwndbpmxqtq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PJ5CtduzMgaIIUDW9VE0hg_nG3fTEc9
